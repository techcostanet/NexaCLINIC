rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if authenticated user is admin
    function isAdmin() {
      return isAuthenticated() && 
        (resource != null && resource.data.role == 'admin' || 
         getUserData().role == 'admin');
    }

    // Users Collection Rules
    match /users/{userId} {
      // Authenticated users can read user records
      allow read: if isAuthenticated();
      
      // Admins can write any user. Users can write their own record (needed for initial bootstrap).
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Sectors Collection Rules
    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Indicators Configuration Rules
    match /indicators/{indicatorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Patients Collection Rules
    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    // Indicator Values / Data Collection Rules
    match /indicator_data/{dataId} {
      // Admins have access to everything.
      // Professionals can only read metrics if the metric's sectorId is in their allowedSectors list.
      allow read: if isAdmin() || (
        isAuthenticated() && 
        resource != null && 
        resource.data.sectorId in getUserData().allowedSectors
      );

      // Admins can write anything.
      // Professionals can write if the new metric is for a sector in their allowedSectors list.
      allow write: if isAdmin() || (
        isAuthenticated() && 
        request.resource != null && 
        request.resource.data.sectorId in getUserData().allowedSectors
      );
    }

    // Upload History Audit collection rules
    match /uploads_history/{uploadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Employees Collection Rules
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
    }

    // Purchases & Invoices Collection Rules
    match /purchases/{purchaseId} {
      allow read, write: if isAuthenticated();
    }
    match /purchase_invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }
    match /web_quotations/{quoteId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
    match /quote_responses/{respId} {
      allow read: if isAuthenticated();
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Stock Items Collection Rules
    match /stock_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Operational Parameters Rules
    match /shifts/{shiftId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /rooms/{roomId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /access_types/{accessId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /dialysis_frequencies/{freqId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // Calendar Events, Appointments, Doctor Schedules & Blocks, Audit Logs, Settings & Profiles Rules
    match /calendar_events/{eventId} { allow read, write: if isAuthenticated(); }
    match /appointments/{id} { allow read, write: if isAuthenticated(); }
    match /doctor_schedules/{id} { allow read, write: if isAuthenticated(); }
    match /schedule_blocks/{id} { allow read, write: if isAuthenticated(); }
    match /audit_logs/{logId} { allow read, write: if isAuthenticated(); }
    match /tenant_settings/{settingId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /user_profiles/{profileId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // Additional Stock & Purchasing Collections
    match /inventory_items/{id} { allow read, write: if isAuthenticated(); }
    match /stock_transactions/{id} { allow read, write: if isAuthenticated(); }
    match /stock_sectors/{id} { allow read, write: if isAuthenticated(); }
    match /suppliers/{id} { allow read, write: if isAuthenticated(); }
    match /material_requisitions/{id} { allow read, write: if isAuthenticated(); }
    match /stock_alerts/{id} { allow read, write: if isAuthenticated(); }
    match /stock_locations/{id} { allow read, write: if isAuthenticated(); }
    match /inventories/{id} { allow read, write: if isAuthenticated(); }
    match /stock_transfers/{id} { allow read, write: if isAuthenticated(); }
    match /stock_loans/{id} { allow read, write: if isAuthenticated(); }
    match /product_categories/{id} { allow read, write: if isAuthenticated(); }

    // Additional Financial Collections
    match /accounts_payable/{id} { allow read, write: if isAuthenticated(); }
    match /accounts_receivable/{id} { allow read, write: if isAuthenticated(); }
    match /bank_statements/{id} { allow read, write: if isAuthenticated(); }
    match /debts/{id} { allow read, write: if isAuthenticated(); }
    match /budget_plans/{id} { allow read, write: if isAuthenticated(); }
    match /agreements/{id} { allow read, write: if isAuthenticated(); }
    match /xml_imports/{id} { allow read, write: if isAuthenticated(); }
    match /cost_centers/{id} { allow read, write: if isAuthenticated(); }

    // Additional HR Collections
    match /transport_vouchers/{id} { allow read, write: if isAuthenticated(); }
    match /hr_warnings/{id} { allow read, write: if isAuthenticated(); }
    match /occupational_exams/{id} { allow read, write: if isAuthenticated(); }

    // SESMT & Segurança do Trabalho Collections
    match /sesmt_epi_inspections/{id} { allow read, write: if isAuthenticated(); }
    match /sesmt_extinguisher_inspections/{id} { allow read, write: if isAuthenticated(); }
    match /sesmt_hydrant_inspections/{id} { allow read, write: if isAuthenticated(); }
    match /sesmt_equipment/{id} { allow read, write: if isAuthenticated(); }

    // NexaASSIST Collections
    match /assist_posts/{id} { allow read, write: if isAuthenticated(); }
  }
}
