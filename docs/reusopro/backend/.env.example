# Copy to .env and fill in. Never commit the real .env.

# --- Core (required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/reusopro
JWT_SECRET=generate-with-openssl-rand-base64-32
PORT=3001

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
FRONTEND_URL=http://localhost:5173

# Optional: database root CA (PEM, "\n" escapes allowed) for full TLS verification.
DATABASE_CA_CERT=

# --- First admin (used only by `npm run seed:admin`) ---
# If ADMIN_SENHA is empty, a random password is generated and printed once.
ADMIN_NOME=Administrador
ADMIN_USERNAME=admin
ADMIN_SENHA=

# --- Serverless cron protection (required on Vercel) ---
# Vercel sends "Authorization: Bearer <CRON_SECRET>" on scheduled calls.
CRON_SECRET=

# --- Report storage (Supabase Storage, private bucket) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=relatorios

# --- Daily limit alert via WhatsApp Cloud API (optional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_TEMPLATE_NAME=lista_limite_reuso
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v21.0

# Number pre-filled in the Dashboard "send limit report" wa.me link (optional).
# Empty = WhatsApp opens the contact picker.
WHATSAPP_DASHBOARD_NUMBER=

# --- Daily limit alert via e-mail / SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
